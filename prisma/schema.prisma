generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // migrate deploy's advisory lock needs a direct connection - Neon's
  // pooled DATABASE_URL routes statements through pgbouncer, which can
  // hand the lock/unlock calls to different backend connections and
  // leave migrate deploy timed out waiting on a lock nothing will ever
  // release.
  directUrl = env("Database_POSTGRES_URL_NON_POOLING")
}

// The league's three time zones, none with daylight saving: the UAE and
// Oman (UTC+4), Qatar (UTC+3) and India (UTC+5:30).
enum LeagueTimeZone {
  GULF
  QATAR
  INDIA
}

enum Role {
  ADMIN
  EDITOR
}

enum Outcome {
  WIN
  LOSS
  DRAW
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SlotOutcome {
  WINNER
  LOSER
}

enum ScoringType {
  // Team score/outcome per school; standings ranked by win/draw/loss points
  // (most team sports: volleyball, basketball, soccer, etc).
  WIN_LOSS
  // Team score per school AND named-individual scores; standings ranked by
  // lowest aggregate score (golf: individual + team tournament).
  LOW_SCORE
  // No standings table at all - results are posted as an attached document
  // (meets/festivals: swimming, cross country, track & field, academic
  // games, speech & debate).
  NONE
}

model School {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  // Short code (e.g. "ASD-DO"), city, and coordinates - used by the schools
  // atlas locator map. All optional since they're cosmetic, not required to
  // run results/standings.
  code         String?
  city         String?
  lat          Float?
  lon          Float?
  // Hex colors (e.g. "#2A6A8A") shown next to this school's name wherever it
  // appears in lists (standings, schedule, schools directory) - purely
  // cosmetic branding, optional. Secondary only ever renders alongside a
  // primary; a school can't set secondary alone.
  themeColor          String?
  themeColorSecondary String?
  // A guest school competes in a tournament without being presented as part
  // of the league: it appears wherever it actually plays (a tournament's
  // schedule, results and team photos) but is left out of the league-wide
  // roster on the home page, in the footer, and in the schools directory.
  isLeagueMember Boolean @default(true)
  // Admin-entered count shown on the public schools page - not derived from
  // actual event participation, since a school's roster for the year is
  // known well before any games are scheduled.
  teamCount           Int     @default(0)
  // Where the school is, for the times of the tournaments it hosts.
  timeZone            LeagueTimeZone @default(GULF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users             User[]
  participants      EventParticipant[]
  results           Result[]
  individualResults IndividualResult[]
  hostedTournaments Tournament[]
  records           Record[]
  hallOfFameEntries HallOfFameEntry[]
  teamPhotos               TeamPhoto[]
  tournamentEntries        TournamentSchool[]
  meetResults              MeetResult[]
  golfPlayers              GolfPlayer[]
  golfHomeMatches          GolfTeamMatch[] @relation("GolfHome")
  golfAwayMatches          GolfTeamMatch[] @relation("GolfAway")
  bowlTeams                BowlTeam[]
  challengeResults         ChallengeResult[]
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role
  schoolId            String?
  school              School?   @relation(fields: [schoolId], references: [id])
  isDisabled          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean   @default(false)
  // Bumped on password reset / disable so existing JWT sessions are
  // invalidated immediately instead of waiting out their expiry.
  tokenVersion        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  photos    Photo[]
  documents Document[]
  auditLogs AuditLog[]

  @@index([schoolId])
}

// The top-level organizational term - exactly three per school year (Fall,
// Winter, Spring: "Season 1/2/3"). Every Activity runs in the same one
// every year.
model Season {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  activities Activity[]
}

// The stable identity of a recurring activity/sport (e.g. "JV Volleyball") -
// its format doesn't change year to year, only its Tournaments (editions) do.
model Activity {
  id          String      @id @default(cuid())
  seasonId    String
  season      Season      @relation(fields: [seasonId], references: [id])
  name        String
  slug        String      @unique
  sport       String
  // Configurable scoring rule so standings math isn't hardcoded to one sport.
  winPoints   Int         @default(3)
  drawPoints  Int         @default(1)
  lossPoints  Int         @default(0)
  scoringType ScoringType @default(WIN_LOSS)
  // Per-column visibility toggles for the WIN_LOSS results table - Team
  // Name and rank are always shown, these five can be turned off per
  // activity from the dashboard.
  showWins          Boolean  @default(true)
  showLosses        Boolean  @default(true)
  showPointsFor     Boolean  @default(true)
  showPointsAgainst Boolean  @default(true)
  showPlayed        Boolean  @default(true)
  // Volleyball-style scoring: a match is decided by sets rather than a
  // single running score, and each event's Result.score/outcome still
  // record the match-level sets-won total, but the schedule/results pages
  // also expose a per-set score editor (variable set count, since a match
  // can end in 2 sets or run the full 5) whose point totals feed the
  // standings For/Against columns instead of Result.score.
  usesSetScores     Boolean  @default(false)
  // Meet-style activities (Swimming, Track & Field) with no win/loss
  // results table (scoringType NONE) can instead offer a per-session CSV
  // import of individual placings - see MeetResult. Off by default; only
  // meaningful when scoringType is NONE.
  usesMeetResults   Boolean  @default(false)
  // Gates the tournament-level "Live results" link/text/photo (see
  // Tournament.liveResultsUrl etc.) both in the admin edit form and on the
  // public tournament page. Only meaningful for activities where a meet or
  // match is scored live elsewhere and posted as a standalone results feed
  // (swimming, track & field, wrestling, cross country) - most team sports
  // just use the regular schedule/results tables instead.
  usesLiveResults   Boolean  @default(false)
  // Golf's own format instead of the generic scoring types: a Day 1
  // individual round scored in points (higher is better) by flight, whose
  // school totals seed a team match-play event - see GolfPlayer/GolfGroup.
  usesGolfFormat    Boolean  @default(false)
  // Academic Games' own schedule: a day-by-day timeline of competitions, with
  // Varsity and Junior Varsity running side by side - see AcademicTimeline.
  usesAcademicFormat Boolean @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  divisions   Division[]
  tournaments Tournament[]
  fields      ActivityField[]

  @@index([seasonId])
}

// An admin-defined extra column for this activity's schedule (e.g.
// "Referee", "Bus time") beyond the standard game fields, which are real
// Event/Result columns and aren't managed through this table.
model ActivityField {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  // Machine-safe key used as the CSV column header (e.g. "referee").
  key        String
  label      String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  values EventFieldValue[]

  @@unique([activityId, key])
}

// Optional Girls/Boys (or JV/Varsity, Overall, etc.) sub-grouping within a
// tournament. Most team sports have two; individual/meet sports and
// inherently single-gender sports (baseball, softball) have none - their
// events just have a null divisionId and the tournament page shows one
// combined schedule/standings.
//
// tournamentId is null only for an Activity's stored "default" divisions -
// a template that gets copied (see createTournamentAction) into its own
// independent set of rows, scoped to tournamentId, the moment a new
// tournament is created. From then on, editing that tournament's divisions
// never touches the default template or any other edition - "a different
// tournament with different divisions" is exactly this: two tournaments,
// two independent sets of rows, both under the same activityId.
model Division {
  id           String      @id @default(cuid())
  activityId   String
  activity     Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  createdAt    DateTime    @default(now())

  events         Event[]
  teamPhotos     TeamPhoto[]
  // A meet-style activity's Division is a skill level (e.g. "Varsity",
  // "Junior Varsity"), assigned per named event rather than per whole
  // session - see MeetProgramEntry/MeetResult. Gender (Girls/Boys) is a
  // separate, independent axis on those same rows.
  programEntries MeetProgramEntry[]
  meetResults    MeetResult[]
  bowlTeams      BowlTeam[]
  bowlGames      BowlGame[]
  challengeResults ChallengeResult[]

  @@unique([activityId, tournamentId, slug])
}

// One year's edition of an Activity - its own dates, host school, and
// events/results. Creating a new edition for an activity (see
// Activity.tournaments) is how last year's edition gets archived: it's
// simply no longer `isCurrent`, but it and everything under it (events,
// results, photos, documents) stays exactly as it was and remains browsable
// at its own permanent URL.
model Tournament {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name         String
  slug         String   @unique
  startDate    DateTime
  endDate      DateTime
  hostSchoolId String?
  hostSchool   School?  @relation(fields: [hostSchoolId], references: [id])
  // Times are entered, stored and shown by default in the tournament's own
  // local time: its host school's zone, unless this is set because it's
  // being held somewhere else.
  timeZone     LeagueTimeZone?
  // Live results during a meet aren't always a hosted website - often it's
  // a photo of a printed sheet, or a few lines of pasted text. All three are
  // independent of Event.streamUrl (a per-event video stream); the public
  // page shows whichever is set, preferring photo, then text, then link.
  liveResultsUrl               String?
  liveResultsText              String?
  liveResultsPhotoUrl          String?
  liveResultsPhotoBlobPathname String?
  isCurrent    Boolean  @default(true)
  // Explicit admin control over the "Archived" label shown on this
  // tournament's public pages - independent of isCurrent, which only
  // decides which edition an activity page picks as the default one to
  // link to. Defaults off so a tournament never shows Archived unless an
  // admin has actually chosen to mark it that way.
  archived     Boolean  @default(false)
  // For a gendered activity's team photo page - when one is off, that
  // division's slots don't get their own section; schools show the other
  // division's photo instead. When both are off, every school's tile is
  // just its name, with no photo attempted. No effect on an ungendered
  // activity (no divisions), which always shows one slot per school.
  showGirlsTeamPhotos Boolean  @default(true)
  showBoysTeamPhotos  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events         Event[]
  teamPhotos     TeamPhoto[]
  divisions      Division[]
  schools        TournamentSchool[]
  programEntries MeetProgramEntry[]
  golfPlayers    GolfPlayer[]
  golfGroups     GolfGroup[]
  golfMatches    GolfTeamMatch[]
  bowlTeams      BowlTeam[]
  bowlGames      BowlGame[]
  challengeResults ChallengeResult[]

  @@index([activityId])
}

// Which schools are taking part in one tournament. A row exists only once an
// admin has changed a school away from its default, so nothing needs
// backfilling: an absent row means "whatever this school's league membership
// implies", which puts every league member in and every guest school out.
model TournamentSchool {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  participating Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([tournamentId, schoolId])
  @@index([tournamentId])
}

// One slot per (school, division) for a tournament's team photo page - one
// school fields at most one Girls team and one Boys team, so the slot grid
// is schools x divisions (6 schools x 2 divisions = 12 for a typical
// gendered activity; just 6 for an ungendered one). A slot exists in the
// database only once an admin uploads a photo or explicitly disables it -
// otherwise it's treated as enabled with no photo yet.
model TeamPhoto {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  divisionId   String?
  division     Division?  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  enabled      Boolean    @default(true)
  photoUrl     String?
  blobPathname String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, schoolId, divisionId])
}

model Event {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisionId   String?
  division     Division?   @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  slug         String
  title        String?
  date         DateTime
  // When it finishes, for schedules shown as time ranges (Academic Games'
  // "9:25am - 10:15am"). Games leave it blank.
  endDate      DateTime?
  location     String?
  status       EventStatus @default(SCHEDULED)
  recap        String?
  // Link to a live video stream for this game (YouTube, Twitch, etc), set
  // per event since only some games get streamed.
  streamUrl    String?
  // Admin-supplied human id from the schedule CSV (e.g. "G14") - lets a
  // re-uploaded CSV update this same game instead of duplicating it, and is
  // what playoff rows reference to say "winner of this game".
  externalId   String?
  // The number in externalId ("G12" -> 12), so games at the same time list
  // in game order - G2 before G10, which sorting the text itself gets wrong.
  // Set by the schedule CSV import alongside externalId.
  gameNumber   Int?
  // Optional explicit display-order override for schedule/results listings,
  // set via the schedule CSV's "order" column - falls back to date order
  // (the default) when unset. Mainly for meet-style activities where
  // multiple same-day sessions need a specific reading order.
  order        Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // A playoff slot that isn't a fixed school yet - filled in automatically
  // once homeSourceEvent (or awaySourceEvent) is scored and its winner/loser
  // is known. Concrete games leave these null and just have participants.
  homeSourceEventId String?
  homeSourceEvent   Event?       @relation("HomeSource", fields: [homeSourceEventId], references: [id], onDelete: SetNull)
  homeSourceOutcome SlotOutcome?
  homeDependents    Event[]      @relation("HomeSource")

  awaySourceEventId String?
  awaySourceEvent   Event?       @relation("AwaySource", fields: [awaySourceEventId], references: [id], onDelete: SetNull)
  awaySourceOutcome SlotOutcome?
  awayDependents    Event[]      @relation("AwaySource")

  // A second kind of pending slot: seeded by a final standings position
  // ("1st", "4th", ...) within this event's own division, rather than by one
  // specific game's winner/loser - e.g. a placement bracket built from pool
  // standings. Filled in automatically once every group-stage game in that
  // division is decided (see resolveStandingSlots) - there's no dependent
  // relation to declare since it isn't tied to one source event.
  homeSourceStanding Int?
  awaySourceStanding Int?

  // A third kind of pending slot: a free-text placeholder ("Local", or just
  // "TBD" for none) for an opponent that isn't in the database yet and has
  // no automatic resolution - filled in by hand later from the event's own
  // "Change who's playing" editor, same as overriding a WINNER()/LOSER()
  // slot before it resolves on its own.
  homeSourceLabel String?
  awaySourceLabel String?

  participants      EventParticipant[]
  results           Result[]
  individualResults IndividualResult[]
  sets              EventSet[]
  meetResults       MeetResult[]
  programEntries    MeetProgramEntry[]
  challengeResults  ChallengeResult[]
  photos            Photo[]
  documents         Document[]
  fieldValues       EventFieldValue[]

  @@unique([tournamentId, slug])
  @@unique([tournamentId, externalId])
  @@index([tournamentId])
  // The sorts the public pages actually run: a tournament's schedule/results
  // by date, the home page's completed-results ticker, and the dashboard's
  // league-wide date ordering.
  @@index([tournamentId, date])
  @@index([status, date])
  @@index([date])
  // Playoff placeholder resolution looks events up by these on every
  // imported row; without an index each lookup is a sequential scan.
  @@index([homeSourceEventId])
  @@index([awaySourceEventId])
}

// One row per set played in a volleyball-style (Activity.usesSetScores)
// match, home/away scored directly against EventParticipant.isHome rather
// than schoolId - only meaningful for a two-side dual match. A match can
// have anywhere from 2 to 5 rows; nothing pads it out to a fixed count.
model EventSet {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  setNumber Int
  homeScore Int
  awayScore Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, setNumber])
  @@index([eventId])
}

enum MeetResultRound {
  PRELIM
  FINAL
}

// Independent of Division (which is a skill level - Varsity/JV - for
// meet-style activities): a named event's Girls/Boys split. Nullable so an
// ungendered meet event still imports fine without one.
enum Gender {
  GIRLS
  BOYS
}

// One athlete's placing in one named event ("100m Freestyle", "Long
// Jump") within a meet session (Event.usesMeetResults activities like
// Swimming or Track & Field - Event here is one day/session of the
// meet). Comes from a CSV import, separate from the whole-session
// results document (Document/recap) - an activity can use either or
// both. A re-import replaces every row for that Event, so there's no
// per-row edit UI; fix a mistake by re-uploading the corrected file.
model MeetResult {
  id             String           @id @default(cuid())
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventName      String
  round          MeetResultRound  @default(FINAL)
  // Copied from the matching MeetProgramEntry at import time (null when no
  // program was uploaded, or that entry didn't set one) - lets the public
  // page filter/group results the same way the program itself is split.
  divisionId     String?
  division       Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  gender         Gender?
  place          Int?
  athleteName    String
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id])
  mark           String
  // Context mark shown alongside the main one - seed time on a PRELIM row,
  // that swimmer's prelim time on a FINAL row. Both optional and unrelated
  // to round validation, so a CSV without them still imports fine.
  seedMark       String?
  prelimMark     String?
  points         Float?
  // Free text so admins can use whatever notation their meet uses (e.g.
  // "MR" for meet record, "SR" for school record) - not a fixed enum.
  recordNotation String?
  // Original CSV row position - a same-batch createMany can give every row
  // an identical createdAt, so this is what keeps event-name groups (and
  // rows within a tied place) in the file's own order on display.
  rowOrder       Int              @default(0)
  createdAt      DateTime         @default(now())

  @@index([eventId])
  @@index([eventId, eventName])
  @@index([divisionId])
}

// The meet's program, set up ahead of results: which named events exist in
// which session, in what order, and for which round(s). Uploaded as its own
// tournament-wide CSV (one file covering every session), separate from the
// per-session MeetResult CSVs - lets a not-yet-run event still show up on
// the public page instead of only appearing once its results are in.
model MeetProgramEntry {
  id            String          @id @default(cuid())
  // Denormalized off of `event` so event_number/round can be unique across
  // the whole meet rather than just within one session - a prelim and its
  // final are two rows sharing an event_number, and they're commonly in two
  // *different* sessions (e.g. a morning prelims session, an evening finals
  // session), so eventId alone can't scope that uniqueness.
  tournamentId  String
  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // The specific session (e.g. "Day 1 Prelims") this round happens in - a
  // race's prelim and final rows can point at two different sessions.
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Skill level (e.g. "Varsity"/"Junior Varsity") and Girls/Boys gender for
  // this one named event - independent of each other, and independent of
  // the session's own Event.divisionId (a session can mix both).
  divisionId    String?
  division      Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  gender        Gender?
  eventNumber   Int
  eventName     String
  round         MeetResultRound @default(FINAL)
  // This specific round's own schedule/display info - independent of its
  // session's, since a session holds many rounds that don't all share one
  // time/location/stream (see the combined schedule+program CSV).
  scheduledTime DateTime
  location      String?
  liveStreamUrl String?
  status        EventStatus     @default(SCHEDULED)
  createdAt     DateTime        @default(now())

  // event_number, not event_name, is the authoritative identity of one race
  // - a prelim row and a final row for the same race share the same
  // event_number (unique per tournament) so they display together, even if
  // their names were typed slightly differently between two CSV uploads.
  @@unique([tournamentId, eventNumber, round])
  @@index([eventId])
  @@index([divisionId])
  @@index([tournamentId])
}

// An admin-entered value for one of the activity's custom schedule fields
// on one event (e.g. this game's "Referee" = "J. Smith").
model EventFieldValue {
  id      String        @id @default(cuid())
  eventId String
  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fieldId String
  field   ActivityField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   String

  @@unique([eventId, fieldId])
  @@index([fieldId])
}

model EventParticipant {
  id       String  @id @default(cuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  // True for the "home" side of a dual match, imported from the CSV's
  // home/away columns. Meaningless (always false) for meets/festivals with
  // more than two participants.
  isHome   Boolean @default(false)

  @@unique([eventId, schoolId])
  @@index([schoolId])
}

model Result {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  score     Int?
  outcome   Outcome?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([eventId, schoolId])
  @@index([schoolId])
}

// Named-individual score within an event, for LOW_SCORE seasons (e.g. golf).
// A team's Result.score for the same event is entered separately -
// individual entries don't need to sum to it.
model IndividualResult {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  athleteName String
  score       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([schoolId])
}

// A results document (typically a PDF) attached to an event - the primary
// way results are posted for NONE-scoring meets/festivals, and an optional
// supplement for any other event.
model Document {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url          String
  blobPathname String
  title        String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([eventId])
}

model Photo {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url          String
  blobPathname String
  caption      String?
  altText      String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  // Admin-picked for the home page slider. Chosen photos always take
  // priority there over recency; the slider only falls back to the
  // newest photos site-wide when nothing has been picked yet.
  featuredOnHome Boolean @default(false)

  @@index([eventId])
  @@index([featuredOnHome, createdAt])
}

// A standing league record (e.g. swimming/track marks) - admin-entered,
// shown on the public Records & Hall of Fame page.
model Record {
  id          String   @id @default(cuid())
  sport       String
  eventName   String
  mark        String
  athleteName String
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sport])
}

// A link out to one school year's full results archive (e.g. a PDF or
// spreadsheet hosted elsewhere) - one row per year, seeded once for the
// fixed 2010-11..2025-26 range. Admins only ever edit resultsUrl.
model SchoolYearArchive {
  id         String   @id @default(cuid())
  startYear  Int      @unique
  resultsUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A Hall of Fame inductee - admin-entered, shown on the public Records &
// Hall of Fame page.
model HallOfFameEntry {
  id           String   @id @default(cuid())
  name         String
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id])
  classYear    Int
  note         String
  photoUrl     String?
  blobPathname String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Append-only audit trail. No update/delete path is exposed anywhere in the app.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorLabel String
  action     String
  entityType String
  entityId   String
  schoolId   String?
  summary    String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// One school's golfer in one tournament. Seed (1-6 within the school) sets
// the flight - seeds 1-2 play Flight 1, 3-4 Flight 2, 5-6 Flight 3 - and,
// for the team event, the fixed pair. Imports match players by school and
// seed rather than by name, so a spelling slip in a later file can't create
// a second player.
model GolfPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  seed         Int
  name         String
  grade        Int?
  gender       String?
  // Day 1 individual points (higher is better). Null until entered.
  points       Int?
  groupId      String?
  group        GolfGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, schoolId, seed])
  @@index([groupId])
}

// A Day 1 tee-time group (usually four players, one per school), with the
// coach marshalling it - the marshal is shown on the dashboard only.
model GolfGroup {
  id           String       @id @default(cuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  flight       Int
  number       Int
  teeTime      DateTime
  course       String?
  marshal      String?
  players      GolfPlayer[]
  createdAt    DateTime     @default(now())

  @@unique([tournamentId, number])
}

enum GolfPairsWinner {
  HOME
  AWAY
  HALVED
}

// One school-vs-school match in a round of the team match play. It's three
// pairs matches, one per flight; the school that wins more of them (a
// halved one is half each) wins the match, and 1½-1½ is a draw.
model GolfTeamMatch {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  startTime    DateTime
  course       String?
  homeSchoolId String
  homeSchool   School           @relation("GolfHome", fields: [homeSchoolId], references: [id])
  awaySchoolId String
  awaySchool   School           @relation("GolfAway", fields: [awaySchoolId], references: [id])
  pairs        GolfPairsMatch[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tournamentId, round, homeSchoolId, awaySchoolId])
  @@index([tournamentId])
}

// One flight's pairs match within a school match. The pairs aren't stored:
// each school's pair for a flight is its two roster players seeded for it
// (seeds 1&2, 3&4, 5&6), fixed for the whole event.
model GolfPairsMatch {
  id        String           @id @default(cuid())
  matchId   String
  match     GolfTeamMatch    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  flight    Int
  startHole Int?
  marshal   String?
  // Null until the pairs match is played.
  winner    GolfPairsWinner?
  // Golf's margin notation - "3 up", "2&1" - shown next to the winner.
  margin    String?

  @@unique([matchId, flight])
}

// ── Academic Games: the Academic Bowl ─────────────────────────────────
// A round robin between teams - each school can field more than one per
// division ("ASDubai Red", "ASDubai Blue") - then seeded finals. Its own
// tables rather than Events, because site games are between schools and
// two teams from one school can meet here.

model BowlTeam {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  // What tells a school's teams apart, usually a colour ("Red"); blank for
  // a school with just the one team.
  name         String     @default("")
  createdAt    DateTime   @default(now())

  gamesAsA BowlGame[] @relation("BowlTeamA")
  gamesAsB BowlGame[] @relation("BowlTeamB")

  @@unique([divisionId, schoolId, name])
}

enum BowlStage {
  ROUND_ROBIN
  QUARTERFINAL
  SEMIFINAL
  CONSOLATION
  FINAL
}

model BowlGame {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  stage        BowlStage  @default(ROUND_ROBIN)
  // The round (1-24) in the round robin; which game of its stage for the
  // finals (Quarterfinal 1-4, Semifinal 1-2, the one Consolation and Final).
  number       Int
  startTime    DateTime
  room         String?
  // Blank until known - a finals slot waits on its source below.
  teamAId      String?
  teamA        BowlTeam?  @relation("BowlTeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamBId      String?
  teamB        BowlTeam?  @relation("BowlTeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  // Where a finals slot's team comes from: "seed 1", "winner QF1", "loser SF2".
  sourceA      String?
  sourceB      String?
  scoreA       Int?
  scoreB       Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tournamentId, divisionId, stage, number])
}

// ── Academic Games: the challenges ─────────────────────────────────────
// Each school's place and score in one challenge (a timeline Event such as
// "Math Challenge") for one division. A challenge that every team sits
// together (Current Events Olympiad) still records Varsity and JV results
// separately, so the division is on the result rather than taken from the
// event.
model ChallengeResult {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  divisionId   String?
  division     Division?  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  place        Int?
  score        Float?
  createdAt    DateTime   @default(now())

  @@index([tournamentId, divisionId])
  @@index([eventId])
}
