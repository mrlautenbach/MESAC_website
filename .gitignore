# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is intentionally committed as a template)
.env*
!.env.example

# vercel
.vercel

# local embedded-postgres test database (pg-embedded-server.mjs)
/.pgdata-devtest

# personal, local-only Claude Code settings
/.claude/settings.local.json

# prisma generated client
/src/generated/prisma

# typescript
*.tsbuildinfo
next-env.d.ts
