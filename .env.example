# Copy this file to .env (local dev) or set these in your hosting provider's
# environment variable settings (production). Never commit real values.

# Postgres connection string. When using Neon/Supabase/Railway, copy the
# connection string they give you here.
DATABASE_URL="postgresql://user:password@localhost:5432/scoreboard?schema=public"

# A direct (non-pooled) connection, required by `prisma migrate deploy`/
# `migrate dev` - a pooled connection (e.g. Neon's default, through
# pgbouncer) can't reliably hold the migration lock. If DATABASE_URL above
# is already a direct connection (a local Postgres, as in the example
# above), just copy the same value here. On Neon/Vercel Postgres, use the
# "non-pooling" connection string from the same dashboard instead.
Database_POSTGRES_URL_NON_POOLING="postgresql://user:password@localhost:5432/scoreboard?schema=public"

# Random secret used to sign session/CSRF tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# The public URL of the deployed site (no trailing slash). Used by Auth.js.
AUTH_URL="http://localhost:3000"

# Vercel Blob storage token for photo uploads. Create a Blob store in the
# Vercel dashboard (Storage tab) and copy its Read/Write token here.
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-token"

# Used only by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="change-me-immediately"
SEED_ADMIN_NAME="League Admin"
